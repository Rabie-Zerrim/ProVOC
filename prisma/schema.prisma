// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 🔵 MODULE 1 — UTILISATEUR & ACCÈS
// ============================================================

model User {
  user_id           String    @id @default(uuid()) @db.Uuid
  display_name      String    @db.VarChar(100)
  language          String    @default("fr") @db.VarChar(10)
  age_verified      Boolean   @default(false)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  preferences       UserPreference?
  consents          DataConsent[]
  roles             UserRole[]           @relation("UserRoles")
  assigned_roles    UserRole[]           @relation("RoleAssigner")
  activity_stats    UserActivityStats?
  reviews           Review[]
  platform_accounts UserPlatformAccount[]
  notifications     Notification[]
  user_credentials  user_credentials?

  @@map("users")
}

model UserPreference {
  pref_id               String   @id @default(uuid()) @db.Uuid
  user_id               String   @unique @db.Uuid
  user                  User     @relation(fields: [user_id], references: [user_id])
  default_tone          String?
  preferred_networks    Json?
  review_reminder_delay Int?
  location_tracking     Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@map("user_preferences")
}

model DataConsent {
  consent_id   String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  user         User      @relation(fields: [user_id], references: [user_id])
  consent_type String
  is_given     Boolean   @default(false)
  given_at     DateTime?
  revoked_at   DateTime?
  version      String?
  ip_address   String?
  created_at   DateTime  @default(now())

  @@map("data_consent")
}

model Role {
  role_id     String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user_roles  UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  permission_id String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?
  resource      String
  action        String
  created_at    DateTime @default(now())

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_perm_id  String   @id @default(uuid()) @db.Uuid
  role_id       String   @db.Uuid
  role          Role     @relation(fields: [role_id], references: [role_id])
  permission_id String   @db.Uuid
  permission    Permission @relation(fields: [permission_id], references: [permission_id])
  created_at    DateTime @default(now())

  @@map("role_permissions")
}

model UserRole {
  user_role_id String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  user         User      @relation("UserRoles", fields: [user_id], references: [user_id])
  role_id      String    @db.Uuid
  role         Role      @relation(fields: [role_id], references: [role_id])
  assigned_by  String?   @db.Uuid
  assigned_by_user User? @relation("RoleAssigner", fields: [assigned_by], references: [user_id])
  assigned_at  DateTime
  expires_at   DateTime?
  created_at   DateTime  @default(now())

  @@map("user_roles")
}

model UserActivityStats {
  stat_id                String    @id @default(uuid()) @db.Uuid
  user_id                String    @unique @db.Uuid
  user                   User      @relation(fields: [user_id], references: [user_id])
  reputation_score       Int       @default(0)
  total_reviews          Int       @default(0)
  most_reviewed_category String?
  total_arbitrations     Int       @default(0)
  last_calculated_at     DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@map("user_activity_stats")
}

model user_credentials {
  credential_id String   @id @db.Uuid
  user_id       String   @unique @db.Uuid
  email         String   @unique @db.VarChar(255)
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt
  user          User     @relation(fields: [user_id], references: [user_id])
}

// ============================================================
// 🟢 MODULE 2 — BUSINESS
// ============================================================

model Business {
  business_id        String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(255)
  parent_business_id String?  @db.Uuid
  parent_business    Business? @relation("BusinessChain", fields: [parent_business_id], references: [business_id])
  sub_businesses     Business[] @relation("BusinessChain")
  business_type      String?
  is_online_only     Boolean  @default(false)
  is_claimed         Boolean  @default(false)
  is_active          Boolean  @default(true)
  public_page_slug   String?  @unique
  qr_code_url        String?
  avg_rating         Decimal? @db.Decimal(3, 2)
  total_reviews      Int      @default(0)
  address            String?
  latitude           Decimal? @db.Decimal(10, 8)
  longitude          Decimal? @db.Decimal(11, 8)
  tags               String[]
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  listings           Listing[]
  reviews            Review[]
  category_id        String?  @db.Uuid
  category           Category? @relation(fields: [category_id], references: [category_id])

  @@map("businesses")
}

model Listing {
  listing_id          String   @id @default(uuid()) @db.Uuid
  business_id         String   @db.Uuid
  business            Business @relation(fields: [business_id], references: [business_id])
  network_id          String   @db.Uuid
  network             Network  @relation(fields: [network_id], references: [network_id])
  external_listing_id String?
  external_rating     Decimal? @db.Decimal(3, 2)
  external_url        String?
  is_active           Boolean  @default(true)
  last_synced_at      DateTime?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  reviews             Review[]
  platform_posts      ReviewPlatformPost[]

  @@map("listings")
}

model Category {
  category_id String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(100)
  description String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  businesses  Business[]

  @@map("categories")
}

// ============================================================
// 🟠 MODULE 3 — NETWORKS & COMPTES
// ============================================================

model Network {
  network_id  String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  base_url    String?
  logo_url    String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  preferences    NetworkPreference?
  user_accounts  UserPlatformAccount[]
  listings       Listing[]
  review_drafts  ReviewDraft[]
  platform_posts ReviewPlatformPost[]

  @@map("networks")
}

model NetworkPreference {
  network_pref_id           String   @id @default(uuid()) @db.Uuid
  network_id                String   @unique @db.Uuid
  network                   Network  @relation(fields: [network_id], references: [network_id])
  max_chars_post            Int?
  min_chars_post            Int?
  rating_type               String
  rating_scale_min          Int      @default(1)
  rating_scale_max          Int      @default(5)
  rating_options            Json?
  has_profanity_filter      Boolean  @default(false)
  supports_api_posting      Boolean  @default(false)
  post_auth_type            String?
  requires_verified_account Boolean  @default(false)
  allows_media_in_review    Boolean  @default(false)
  max_media_count           Int?
  supports_update_review    Boolean  @default(false)
  supports_delete_review    Boolean  @default(false)
  max_chars_reply           Int?
  min_chars_reply           Int?
  supports_api_reply        Boolean  @default(false)
  reply_auth_type           String?
  reply_requires_ownership  Boolean  @default(true)
  supports_food_rating      Boolean  @default(false)
  supports_service_rating   Boolean  @default(false)
  supports_ambiance_rating  Boolean  @default(false)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  @@map("network_preferences")
}

model UserPlatformAccount {
  account_id       String    @id @default(uuid()) @db.Uuid
  user_id          String    @db.Uuid
  user             User      @relation(fields: [user_id], references: [user_id])
  network_id       String    @db.Uuid
  network          Network   @relation(fields: [network_id], references: [network_id])
  oauth_token      String?
  refresh_token    String?
  token_expires_at DateTime?
  is_primary       Boolean   @default(false)
  external_user_id String?
  is_active        Boolean   @default(true)
  connected_at     DateTime?
  created_at       DateTime  @default(now())

  platform_posts   ReviewPlatformPost[]

  @@map("user_platform_accounts")
}

// ============================================================
// 🔴 MODULE 4 — REVIEW — TABLE CENTRALE
// ============================================================

model Review {
  review_id   String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  user        User      @relation(fields: [user_id], references: [user_id])
  business_id String    @db.Uuid
  business    Business  @relation(fields: [business_id], references: [business_id])
  listing_id  String?   @db.Uuid
  listing     Listing?  @relation(fields: [listing_id], references: [listing_id])
  review_text String
  rating      Int
  status      String
  tone        String?
  intent      String?
  language    String?   @db.VarChar(10)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  medias      ReviewMedia[]
  histories   ReviewHistory[]
  drafts      ReviewDraft[]
  platform_posts ReviewPlatformPost[]

  @@map("reviews")
}

model ReviewMedia {
  media_id          String   @id @default(uuid()) @db.Uuid
  review_id         String   @db.Uuid
  review            Review   @relation(fields: [review_id], references: [review_id])
  media_type        String?
  s3_key            String
  original_filename String?
  file_size_bytes   Int?
  mime_type         String?
  thumbnail_url     String?
  uploaded_at       DateTime @default(now())
  created_at        DateTime @default(now())

  @@map("review_medias")
}

model ReviewHistory {
  history_id      String   @id @default(uuid()) @db.Uuid
  review_id       String   @db.Uuid
  review          Review   @relation(fields: [review_id], references: [review_id])
  previous_status String?
  new_status      String
  snapshot_text   String?
  changed_by_type String?
  changed_by_id   String?  @db.Uuid
  reason          String?
  created_at      DateTime @default(now())

  @@map("review_histories")
}

model ReviewDraft {
  draft_id         String   @id @default(uuid()) @db.Uuid
  review_id        String   @db.Uuid
  review           Review   @relation(fields: [review_id], references: [review_id])
  network_id       String?  @db.Uuid
  network          Network? @relation(fields: [network_id], references: [network_id])
  version          Int      @default(1)
  draft_text       String
  compliance_check Boolean  @default(true)
  is_selected      Boolean  @default(false)
  created_at       DateTime @default(now())

  @@map("review_drafts")
}

// ============================================================
// 🟡 MODULE 5 — PUBLICATION & NOTIFICATIONS
// ============================================================

model ReviewPlatformPost {
  post_id                  String   @id @default(uuid()) @db.Uuid
  review_id                String   @db.Uuid
  review                   Review   @relation(fields: [review_id], references: [review_id])
  network_id               String   @db.Uuid
  network                  Network  @relation(fields: [network_id], references: [network_id])
  listing_id               String?  @db.Uuid
  listing                  Listing? @relation(fields: [listing_id], references: [listing_id])
  user_platform_account_id String   @db.Uuid
  user_account             UserPlatformAccount @relation(fields: [user_platform_account_id], references: [account_id])
  external_review_id       String?
  status                   String
  platform_specific_text   String?
  scheduled_at             DateTime?
  posted_at                DateTime?
  retry_count              Int      @default(0)
  likes_count              Int      @default(0)
  error_message            String?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  @@map("review_platform_posts")
}

model Notification {
  notification_id String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  user            User     @relation(fields: [user_id], references: [user_id])
  type            String
  category        String?
  title           String?  @db.VarChar(255)
  body            String?
  data            Json?
  is_read         Boolean  @default(false)
  is_sent         Boolean  @default(false)
  sent_at         DateTime?
  scheduled_for   DateTime?
  created_at      DateTime @default(now())

  @@map("notifications")
}
